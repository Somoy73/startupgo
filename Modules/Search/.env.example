# Copy to .env and add the keys. Never commit .env.
# Keys are free at build.nvidia.com; one NVIDIA key can be used for both.
# Changing EMBEDDING_MODEL or EMBEDDING_DIM later means processing everything again
# (delete rag_storage/ and run process-storage).

# Chat model: extracts entities and relations (process-storage) and query keywords (search)
CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
CHAT_API_KEY=

# Embedding model and the size of its vectors
EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v1
EMBEDDING_API_KEY=
EMBEDDING_DIM=2048
